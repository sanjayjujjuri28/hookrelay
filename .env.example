# =========================================================
# HookRelay Environment Variables Configuration
# Copy this file to .env and configure your production values
# =========================================================

# Database Connection (PostgreSQL 14+)
# Supports postgresql://, postgresql+psycopg://, and postgres:// prefixes
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/hookrelay

# JWT Secret Key (Must be at least 32 characters for HS256 security)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_a_secure_random_32_byte_hex_string_here

# Gmail SMTP Email Delivery (100% Free OTP Delivery Worldwide)
# 1. Enable 2-Factor Authentication on your Google Account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an App Name "HookRelay" and copy the 16-character password
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=abcd efgh ijkl mnop

# Optional: Resend API (Alternative fallback email provider)
# RESEND_API_KEY=re_your_resend_api_key_here

# Server Port (Render, Railway, Fly automatically provide $PORT)
PORT=8000
